// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy Tab S2 9.7 Wi-Fi (SM-T810, Exynos 5433) - mainline bring-up.
 *
 * Milestone 1: just enough to boot a 32-bit kernel (the Samsung bootloader
 * enters the kernel in AArch32 SVC mode, MMU on) and log through the sec_log
 * RAM buffer.  One CPU, GIC, arch timer, chip id.  Everything else comes later.
 */
/dts-v1/;
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	model = "Samsung Galaxy Tab S2 9.7 Wi-Fi (SM-T810)";
	compatible = "samsung,gts210wifi", "samsung,exynos5433";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	chosen {
		bootargs = "earlycon=seclog,0x25fffff8 keep_bootcon ignore_loglevel loglevel=8 printk.time=1 panic=0";
	};

	memory@20000000 {
		device_type = "memory";
		/* 256 MiB for now; the board has 0x20000000-0xde980000 */
		reg = <0x20000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Samsung's log areas: sec_log (2 MiB at 0x26000000, with its
		 * header just below), sec_tima_log, sec_avc_log, sec_pstore.
		 */
		sec-logs@25fff000 {
			reg = <0x25fff000 0x547000>;
			no-map;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		chipid@10000000 {
			compatible = "samsung,exynos5433-chipid",
				     "samsung,exynos4210-chipid";
			reg = <0x10000000 0x100>;
		};

		gic: interrupt-controller@11001000 {
			compatible = "arm,gic-400";
			#address-cells = <0>;
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0x11001000 0x1000>,
			      <0x11002000 0x2000>,
			      <0x11004000 0x2000>,
			      <0x11006000 0x2000>;
			interrupts = <GIC_PPI 9 0xf04>;
		};
	};

	arch_timer: timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;
		clock-frequency = <24000000>;
	};
};
